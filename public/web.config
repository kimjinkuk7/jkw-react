<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   react/dist  :  빌드 산출물 전용 IIS 설정
  ============================================================================
   이 파일은 react/public/ 에 두었고 Vite 가 빌드할 때 dist/ 로 복사한다.
   (public/ 의 내용은 그대로 dist 루트에 복사된다)

   1) SPA 딥링크 대응
      /react/dist/board/free 같은 주소는 실제 파일이 아니라 라우터가 아는 경로다.
      IIS 는 파일이 없으니 404 를 낸다. 그래서 404 를 index.html 로 돌린다.

      URL Rewrite 모듈을 쓰지 않는 이유 : 이 서버에 설치되어 있지 않다.
        (HKLM\SOFTWARE\Microsoft\IIS Extensions\URL Rewrite 없음, 2026-11-20 확인)
      httpErrors 는 IIS 기본 모듈이라 추가 설치가 필요 없다.

      ※ responseMode="ExecuteURL" 은 index.html 의 내용을 돌려주지만
        상태코드는 원래의 404 가 그대로 나간다. 브라우저 동작에는 지장이 없고
        라우터가 정상적으로 화면을 그린다. 검색엔진 노출이 필요해지면
        그때 URL Rewrite 를 설치해 200 으로 바꾼다.

   2) index.html 은 캐시하지 않는다
      해시가 붙은 assets/*.js 는 영구 캐시해도 되지만, 그 파일명을 가리키는
      index.html 이 캐시되면 배포 후에도 옛 번들을 계속 불러온다.
  ============================================================================
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/react/dist/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <!-- 디버그 빌드(npm run build:debug)가 만드는 소스맵.
           IIS 기본 MIME 목록에 .map 이 없어 그냥 두면 404 가 난다. -->
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

  </system.webServer>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>

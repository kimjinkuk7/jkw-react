<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   jkw.com  :  React 스택  (단독 리포지토리)
  ============================================================================
   이 폴더 하나로 SPA 와 그 백엔드가 모두 돌아간다.

       dist/        빌드된 SPA        <- IIS 가 서비스하는 화면
       server-asp/  Classic ASP JSON API (동봉된 백엔드)
       upload/      업로드 파일
       src/ public/ node_modules/  소스와 빌드 입력  <- 서비스 대상 아님

   dist/ 전용 설정(SPA 딥링크 404 처리 등)은 public/web.config 에 있고
   Vite 가 빌드할 때 dist/web.config 로 복사한다.

   [배치]
     권장 : 이 폴더를 IIS 사이트의 물리 경로로 지정한다. 그 경우
              server-asp/App.Conf.asp  APP_ROOT   = "/server-asp"
                                       UPLOAD_ROOT= "/upload"
                                       SPA_ROOT   = "/dist"
              src/app/config.js        VITE_API_BASE=/server-asp/api  (.env)
     대안 : 사이트 루트 아래 react 폴더로 둔다 (현재 개발 PC 가 이 형태).
              APP_ROOT = "/react/server-asp" , UPLOAD_ROOT = "/react/upload"

   [★ 중요 — asp 섹션은 애플리케이션 루트에서만 적용된다]
     system.webServer/asp 는 IIS 애플리케이션 루트의 web.config 에서만 반영된다.
     하위 디렉터리에 두면 IIS 가 오류 없이 조용히 무시한다. (2026-11-24 실측)
     server-asp 의 include 는 전부 상대경로라 enableParentPaths 가 반드시 필요하다.
       - 이 폴더가 사이트 루트  -> 아래 asp 섹션이 그대로 적용된다
       - 사이트 루트 아래 react 폴더 -> 무시된다. 사이트 루트 web.config 에 같은 값을 넣어야 한다

   [사전 작업] asp 구성 섹션은 IIS 기본이 잠금(Deny)이라 해제해야 한다.
     appcmd.exe unlock config -section:system.webServer/asp

   [주의] XML 주석 안에는 하이픈 2개를 연속으로 쓸 수 없다.
          구분선은 = 문자만 사용할 것.
  ============================================================================
-->
<configuration>

  <system.webServer>

    <!-- /  ->  default.asp  ->  dist/  (SPA) -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />


    <!-- ====================================================================
         Classic ASP 런타임  (server-asp 백엔드용)
         ====================================================================
         enableParentPaths : ★ 필수. server-asp 의 include 가 전부 상대경로이고
                             ../ 로 상위를 거슬러 올라간다. false 면 API 전체 500.
         ==================================================================== -->
    <asp
        enableParentPaths="true"
        bufferingOn="true"
        scriptLanguage="VBScript"
        codePage="65001"
        lcid="1042"
        errorsToNTLog="true"
        scriptErrorSentToBrowser="true"
        appAllowClientDebug="false"
        appAllowDebugging="false">

      <limits maxRequestEntityAllowed="20971520"
              scriptTimeout="00:01:30"
              bufferingLimit="20971520" />

      <session allowSessionState="true"
               keepSessionIdSecure="true"
               timeout="02:00:00" />

      <cache diskTemplateCacheDirectory="%TEMP%"
             enableTypelibCache="true"
             scriptFileCacheSize="500"
             scriptEngineCacheMax="250" />
    </asp>


    <!-- ====================================================================
         보안 : 소스 / 빌드 입력 직접 접근 차단
         ====================================================================
         서비스되는 것은 dist/ 와 server-asp/api/ 와 upload/ 이미지뿐이다.
         server-asp 의 내부 계층(code/model/lib/conf)과 App.Conf.asp 는 막는다.
         서버 사이드 include 는 HTTP 요청이 아니므로 영향을 받지 않는다.
         ==================================================================== -->
    <security>
      <requestFiltering removeServerHeader="true">

        <hiddenSegments>
          <add segment="src" />
          <add segment="public" />
          <add segment="node_modules" />
          <add segment="code" />
          <add segment="model" />
          <add segment="lib" />
          <add segment="conf" />
          <add segment="db" />
          <add segment="docs" />
          <add segment="tools" />
          <add segment="App.Conf.asp" />
          <add segment=".git" />
          <add segment=".github" />
        </hiddenSegments>

        <fileExtensions allowUnlisted="true">
          <add fileExtension=".jsx"    allowed="false" />
          <add fileExtension=".ts"     allowed="false" />
          <add fileExtension=".tsx"    allowed="false" />
          <add fileExtension=".json"   allowed="false" />
          <add fileExtension=".lock"   allowed="false" />
          <add fileExtension=".sql"    allowed="false" />
          <add fileExtension=".md"     allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".log"    allowed="false" />
          <add fileExtension=".ps1"    allowed="false" />
          <add fileExtension=".env"    allowed="false" />
        </fileExtensions>

        <requestLimits maxAllowedContentLength="20971520" />

        <!-- 경로 조작 차단. 콜론은 넣지 말 것 (쿼리스트링까지 400 이 된다) -->
        <denyUrlSequences>
          <add sequence=".." />
        </denyUrlSequences>

      </requestFiltering>
    </security>


    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Detailed" existingResponse="Auto" />

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>


  <!-- ======================================================================
       업로드 폴더 : 실행 권한 제거
       ======================================================================
       업로드된 파일이 ASP 로 실행되는 것을 막는다.
       썸네일은 img 태그로 직접 표시하므로 이미지 확장자만 정적 읽기를 허용하고,
       그 밖의 첨부는 server-asp/api/Download.asp 를 경유하게 한다.
       ====================================================================== -->
  <location path="upload">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="false">
            <add fileExtension=".jpg"  allowed="true" />
            <add fileExtension=".jpeg" allowed="true" />
            <add fileExtension=".gif"  allowed="true" />
            <add fileExtension=".png"  allowed="true" />
            <add fileExtension=".webp" allowed="true" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>


  <!-- ======================================================================
       API 응답은 캐시하지 않는다
       ====================================================================== -->
  <location path="server-asp">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-store" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>

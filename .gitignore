# --- 의존성 / 빌드 산출물 -------------------------------------------------
node_modules/
dist/
*.tsbuildinfo

# --- 업로드 파일 ---------------------------------------------------------
# server-asp 백엔드가 여기에 쓴다. 폴더 구조만 남긴다.
upload/**
!upload/
!upload/*/
!upload/**/.gitkeep

# --- 로컬 전용 -----------------------------------------------------------
*.log
npm-debug.log*
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- 비밀값 --------------------------------------------------------------
# .env.example 은 올리고 실제 값은 올리지 않는다.
.env
.env.local
.env.*.local
server-asp/App.Conf.local.asp
*.secret
